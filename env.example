# Configurações de Banco de Dados
# Desenvolvimento e Produção: PostgreSQL
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/som_popular

# Para produção, use uma URL de conexão segura:
# DATABASE_URL=postgresql://username:password@host:port/database

# Configurações de Autenticação
BETTER_AUTH_SECRET=your-super-secret-key
BETTER_AUTH_TELEMETRY=0

# Configurações de Email (Resend)
RESEND_API_KEY=your_resend_api_key
RESEND_FROM_EMAIL=your-email@domain.com

# Configurações de Upload de Arquivos
# Opções: local, s3, idrive, vercel-blob
STORAGE_PROVIDER=vercel-blob

# Para Vercel Blob (Recomendado para SaaS)
# STORAGE_PROVIDER=vercel-blob
# BLOB_READ_WRITE_TOKEN=vercel_blob_token_here
# O Vercel Blob é configurado automaticamente no Vercel
# Para desenvolvimento local, você pode usar um token de teste

# Para AWS S3
# STORAGE_PROVIDER=s3
# AWS_ACCESS_KEY_ID=your_access_key
# AWS_SECRET_ACCESS_KEY=your_secret_key
# AWS_REGION=us-east-1
# AWS_BUCKET_NAME=your_bucket_name

# Para IDrive e2 (S3 Compatible Storage)
# STORAGE_PROVIDER=idrive
# IDRIVE_ACCESS_KEY_ID=your_idrive_access_key
# IDRIVE_SECRET_ACCESS_KEY=your_idrive_secret_key
# IDRIVE_BUCKET_NAME=your_bucket_name
# IDRIVE_ENDPOINT_URL=https://your-region.idrivee2-2.com
# IDRIVE_REGION=your_region

# Para storage local (desenvolvimento)
# STORAGE_PROVIDER=local

# Monitoramento de Erros (Sentry) - Apenas em Produção
# O Sentry só é ativado quando NODE_ENV=production
SENTRY_DSN=your_sentry_dsn_here
SENTRY_ENVIRONMENT=production
SENTRY_ORG=your_sentry_org
SENTRY_PROJECT=your_sentry_project
NEXT_PUBLIC_SENTRY_DSN=your_public_sentry_dsn_here

# Para desenvolvimento, o Sentry fica desabilitado automaticamente
# Não é necessário configurar nada para desenvolvimento

# Provedores de IA
# Defina ao menos uma chave de API para usar os recursos de IA
OPENAI_API_KEY=your_openai_api_key
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENROUTER_API_KEY=your_openrouter_api_key
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# LLM_MODEL_ID=openai/gpt-5-nano
